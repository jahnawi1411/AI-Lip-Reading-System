# Reference only: supply these through your host's environment/secrets manager.
VISIONSPEAK_ENV=production
PORT=8080
# Generate a random secret, do not use a shared example token.
VISIONSPEAK_API_TOKEN=
VISIONSPEAK_SECRET_KEY=
# Compose uses an alphanumeric database password (URL-encode special characters).
POSTGRES_PASSWORD=
# For hosted PostgreSQL, set a database URL using the psycopg driver:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/visionspeak
# Optional absolute mounted checkpoint path:
# VISIONSPEAK_WEIGHTS=/models/checkpoint.weights.h5
# VISIONSPEAK_REFERENCE_WEIGHTS=/models/lipnet-reference/unseen-weights178.h5
# VISIONSPEAK_UPLOAD_ROOT=/tmp
VISIONSPEAK_AUDIO_MODEL=base
# 1 is faster; use 5 to explore more transcript alternatives (more CPU time).
VISIONSPEAK_AUDIO_BEAM_SIZE=5

# Provisional container limits; measure peak RAM and latency on the target host.
WEB_MEMORY_LIMIT=8g
WEB_CPU_LIMIT=4
